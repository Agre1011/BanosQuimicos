<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BanosQuimicos.App</RootNamespace>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="../BanosQuimicos.Api/BanosQuimicos.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Comparte el código cliente real sin depender del runtime Android/Windows en los tests. -->
    <Compile Include="../BanosQuimicos.App/Autenticacion/*.cs" Link="App/Autenticacion/%(Filename)%(Extension)" />
    <Compile Include="../BanosQuimicos.App/Plataforma/ConexionApi.cs" Link="App/ConexionApi.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Los componentes reales permiten probar el paso de selección/confirmación, no solo HTTP. -->
    <RazorComponent Include="../BanosQuimicos.App/Components/_Imports.razor" Link="Components/_Imports.razor" />
    <RazorComponent Include="../BanosQuimicos.App/Components/Cuentas/GestionCuentas.razor" Link="Components/Cuentas/GestionCuentas.razor" />
    <RazorComponent Include="../BanosQuimicos.App/Components/Empleados/*.razor" Link="Components/Empleados/%(Filename)%(Extension)" />
    <RazorComponent Include="../BanosQuimicos.App/Components/Clientes/*.razor" Link="Components/Clientes/%(Filename)%(Extension)" />
    <RazorComponent Include="../BanosQuimicos.App/Components/Administracion/*.razor" Link="Components/Administracion/%(Filename)%(Extension)" />
    <RazorComponent Include="../BanosQuimicos.App/Components/Pages/Home.razor" Link="Components/Pages/Home.razor" />
    <RazorComponent Include="../BanosQuimicos.App/Components/Autenticacion/*.razor" Link="Components/Autenticacion/%(Filename)%(Extension)" />
    <RazorComponent Include="../BanosQuimicos.App/Components/Layout/MainLayout.razor" Link="Components/Layout/MainLayout.razor" />
  </ItemGroup>
</Project>
