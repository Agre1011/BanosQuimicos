@using BanosQuimicos.App.Autenticacion
@inject SesionUsuario Sesion

@if (direccionAbierta && detalle is not null)
{
    <DireccionBajaCliente Servicio="detalle" Volver="CerrarAccion" />
}
else if (reclamoAbierto && detalle is not null)
{
    <SolicitudServicio Servicio="detalle" Reclamo="true" Volver="CerrarAccion" />
}
else
{
<section class="cliente-vista" aria-labelledby="titulo-servicios-cliente" aria-busy="@cargando">
    <h1 id="titulo-servicios-cliente">@(enDetalle ? "Detalle del servicio" : "Mis Servicios")</h1>
    @if (cargando) { <p role="status">Consultando el servicio…</p> }
    else if (error is not null)
    {
        <p class="aviso error" role="alert">@error</p>
        <button class="principal" @onclick="Reintentar">Volver a consultar</button>
    }
    else if (enDetalle && detalle is { } s)
    {
        <article class="cliente-tarjeta">
            <h2>@s.CodigoBano</h2>
            <dl>
                <dt>Tipo</dt><dd>@s.TipoBano / @s.TipoUso</dd>
                <dt>Dirección</dt><dd>@(s.Direccion ?? "Sin dirección registrada")</dd>
                <dt>Limpieza</dt><dd>@Frecuencia(s)</dd>
                <dt>Estado</dt><dd>@s.EstadoServicio</dd>
            </dl>
        </article>
        @if (confirmarBaja)
        {
            <DireccionBajaCliente Servicio="s" Baja="true" Volver="CerrarAccion" />
        }
        else if (confirmarLimpieza)
        {
            <SolicitudServicio Servicio="s" Volver="CerrarAccion" />
        }
        else
        {
        <button class="cliente-opcion" disabled="@(s.EstadoServicio != "Entregado")" @onclick="() => confirmarLimpieza = true">Solicitar Limpieza Extra</button>
        <button class="cliente-opcion" disabled="@(s.EstadoServicio != "Entregado" || s.IdUbicacionActual is null)" @onclick="() => direccionAbierta = true">Solicitar o informar cambio de dirección</button>
        <button class="cliente-opcion" disabled="@(s.EstadoServicio != "Entregado")" @onclick="() => reclamoAbierto = true">Realizar Reclamo</button>
        <button class="cliente-opcion cliente-baja" disabled="@(s.EstadoServicio != "Entregado")" @onclick="() => confirmarBaja = true">Dar de Baja</button>
        <p class="cliente-pendiente">Estas solicitudes requieren un servicio Entregado y revisión del administrador.</p>
        }
    }
    else if (!enDetalle)
    {
        @if (servicios.Count == 0) { <p role="status">No tenés servicios vigentes.</p> }
        @foreach (var servicio in servicios)
        {
            <article class="cliente-tarjeta" @key="servicio.IdServicio">
                <h2>@servicio.CodigoBano</h2>
                <dl>
                    <dt>Tipo</dt><dd>@servicio.TipoBano / @servicio.TipoUso</dd>
                    <dt>Dirección</dt><dd>@(servicio.Direccion ?? "Sin dirección registrada")</dd>
                    <dt>Limpieza</dt><dd>@Frecuencia(servicio)</dd>
                </dl>
                <button class="cliente-detalle" @onclick="() => Abrir(servicio.IdServicio)">Ver detalle</button>
            </article>
        }
        <Paginador Total="total" Pagina="pagina" Ocupada="cargando" Cambiar="Paginar" />
        <button class="principal" @onclick="Cargar">Consultar nuevamente</button>
    }
    @if (!confirmarLimpieza && !confirmarBaja) { <button class="volver" disabled="@cargando" @onclick="Regresar">Volver</button> }
</section>
}

@code {
    [Parameter] public EventCallback Volver { get; set; }
    private int pagina = 1, total;
    private List<ServicioCliente> servicios = [];
    private ServicioCliente? detalle;
    private bool cargando, enDetalle;
    private bool confirmarLimpieza, reclamoAbierto;
    private bool direccionAbierta, confirmarBaja;
    private int idDetalle;
    private string? error;
    protected override Task OnInitializedAsync() => Cargar();
    private static string Frecuencia(ServicioCliente s) => s.CantidadLimpiezasSemana == 0
        ? "Sin limpieza semanal programada" : $"{s.CantidadLimpiezasSemana} x semana";
    private async Task Cargar()
    {
        cargando = true; error = null; servicios = []; detalle = null;
        try { var p = await Sesion.PaginaMisServiciosAsync(pagina); servicios = p.Elementos; pagina = p.PaginaActual; total = p.Total; }
        catch (ErrorApi ex) { error = ex.Message; }
        finally { cargando = false; }
    }
    private Task Paginar(int p) { if (cargando) return Task.CompletedTask; pagina = p; return Cargar(); }
    private async Task Abrir(int id)
    {
        confirmarLimpieza = false; reclamoAbierto = false;
        direccionAbierta = false; confirmarBaja = false;
        enDetalle = true; idDetalle = id; detalle = null; error = null; cargando = true;
        // Consultar nuevamente protege también cambios ocurridos desde la carga del listado.
        try { detalle = await Sesion.MiServicioAsync(id); }
        catch (ErrorApi ex) { error = ex.Message; }
        finally { cargando = false; }
    }
    private Task Reintentar() => enDetalle ? Abrir(idDetalle) : Cargar();
    private Task CerrarAccion() => Abrir(idDetalle);
    private async Task Regresar()
    {
        if (enDetalle) { enDetalle = false; await Cargar(); }
        else await Volver.InvokeAsync();
    }
}
