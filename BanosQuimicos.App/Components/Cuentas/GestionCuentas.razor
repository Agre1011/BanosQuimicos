@using BanosQuimicos.App.Autenticacion
@inject SesionUsuario Sesion
@implements IDisposable

<section class="tarjeta" aria-labelledby="titulo-cuentas" aria-busy="@ocupada">
    <h1 id="titulo-cuentas">Clientes y Empleados</h1>
    @if (!string.IsNullOrEmpty(aviso)) { <div class="aviso" role="status">@aviso</div> }
    @if (!string.IsNullOrEmpty(error)) { <div class="aviso error" role="alert">@error</div> }
    @if (ocupada) { <p role="status">Consultando cuentas…</p> }
    <fieldset disabled="@(ocupada || Sesion.Ocupada)">
    @if (idSeleccionado is null)
    {
        <div class="pestanas-cuentas" role="group" aria-label="Tipo de cuenta">
            <button class="secundario" aria-pressed="@(rolListado == "Cliente")" @onclick='() => FiltrarRolAsync("Cliente")'>Clientes</button>
            <button class="secundario" aria-pressed="@(rolListado == "Empleado")" @onclick='() => FiltrarRolAsync("Empleado")'>Empleados</button>
        </div>
        <form @onsubmit="BuscarAsync" @onsubmit:preventDefault>
            <label for="busqueda-cuentas">Nombre, apellido o correo</label>
            <input id="busqueda-cuentas" maxlength="254" @bind="busqueda" />
            <label for="estado-cuentas">Estado de cuenta</label>
            <select id="estado-cuentas" @bind="estado">
                <option value="">Todos</option><option>Pendiente</option><option>Activa</option>
                <option>Suspendida</option><option value="BajaLogica">Baja lógica</option>
            </select>
            <button class="principal" type="submit">Buscar</button>
        </form>
        @if (listado is { } lista)
        {
            <p role="status">@lista.Total cuenta(s). Página @pagina de @TotalPaginas.</p>
            @if (lista.Elementos.Count == 0) { <p>No hay cuentas para los filtros seleccionados.</p> }
            @foreach (var item in lista.Elementos)
            {
                <article class="cuenta-resumen" @key="item.IdUsuario">
                    <h2>@item.Nombre @item.Apellido</h2>
                    <p>@item.Email</p><p>Rol guardado: <strong>@item.Rol</strong> · @EstadoVisible(item.EstadoCuenta)</p>
                    @if (item.Rol is "Cliente" or "Empleado")
                    {
                        <label for="@($"rol-{item.IdUsuario}")">Cambiar rol (requiere confirmación)</label>
                        <select id="@($"rol-{item.IdUsuario}")" value="@(cambioRol?.IdUsuario == item.IdUsuario ? nuevoRol : item.Rol)" @onchange="e => PrepararRol(item, e.Value?.ToString())">
                            <option>Cliente</option><option>Empleado</option>
                        </select>
                        @if (cambioRol?.IdUsuario == item.IdUsuario)
                        {
                            <div class="aviso" role="group" aria-labelledby="@($"confirmar-rol-{item.IdUsuario}")">
                                <p id="@($"confirmar-rol-{item.IdUsuario}")"><strong>Cambio sin guardar:</strong> @item.Rol → @nuevoRol.</p>
                                <p>¿Confirmás cambiar el rol de @item.Nombre @item.Apellido (@item.Email)? Esta operación no modifica el estado de cuenta.</p>
                                <button class="principal" @onclick="ConfirmarRolAsync">Confirmar cambio de rol</button>
                                <button class="secundario" @onclick="CancelarRol">Cancelar</button>
                            </div>
                        }
                    }
                    <button class="principal" @onclick="() => AbrirAsync(item.IdUsuario)">Ver detalle</button>
                </article>
            }
            <nav aria-label="Páginas de cuentas">
                <button class="secundario" disabled="@(pagina <= 1)" @onclick="() => PaginarAsync(-1)">Anterior</button>
                <button class="secundario" disabled="@(pagina >= TotalPaginas)" @onclick="() => PaginarAsync(1)">Siguiente</button>
            </nav>
        }
        <button class="principal" @onclick="CargarAsync">Actualizar listado</button>
        <button class="secundario" @onclick="Volver">Volver al inicio</button>
    }
    else
    {
        @if (detalle is { } cuenta)
        {
            <h2>@cuenta.Nombre @cuenta.Apellido</h2>
            <dl class="cuenta-detalle">
                <dt>Correo electrónico</dt><dd>@cuenta.Email</dd>
                <dt>Teléfono</dt><dd>@cuenta.Telefono</dd>
                <dt>Rol</dt><dd>@cuenta.Rol</dd>
                <dt>Estado</dt><dd>@EstadoVisible(cuenta.EstadoCuenta)</dd>
                @if (cuenta.MotivoSuspension is not null) { <dt>Último motivo de suspensión</dt><dd>@cuenta.MotivoSuspension</dd> }
                @if (cuenta.FechaBaja is { } baja) { <dt>Fecha de baja (hora local)</dt><dd>@baja.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd> }
                <dt>Fecha de registro (hora local)</dt><dd>@cuenta.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>
            @if (cuenta.EstadoCuenta == "BajaLogica")
            { <p class="aviso">Cuenta dada de baja. No puede reactivarse desde la app. Los datos y el historial se conservan.</p> }
            else if (cuenta.IdUsuario != Sesion.Cuenta?.IdUsuario)
            {
                @if (cuenta.EstadoCuenta == "Activa") { <button class="secundario" @onclick='() => PrepararEstado("Suspendida")'>Suspender cuenta</button> }
                @if (cuenta.EstadoCuenta == "Suspendida") { <button class="principal" @onclick='() => PrepararEstado("Activa")'>Reactivar cuenta</button> }
                <button class="salir" @onclick='() => PrepararEstado("BajaLogica")'>Dar de baja la cuenta</button>
                @if (destinoEstado is not null)
                {
                    <div class="aviso" role="group" aria-label="Confirmación de estado">
                        <p>¿Confirmás cambiar a @EstadoVisible(destinoEstado) la cuenta de @cuenta.Nombre @cuenta.Apellido (@cuenta.Email)? Se conserva su rol @cuenta.Rol.</p>
                        @if (destinoEstado == "Suspendida")
                        {
                            <label for="motivo-suspension">Motivo de suspensión (obligatorio)</label>
                            <textarea id="motivo-suspension" maxlength="1000" style="width:100%;min-height:5rem;font:inherit" @bind="motivo"></textarea>
                        }
                        @if (destinoEstado == "BajaLogica") { <p><strong>La baja es definitiva desde la app: no podrá reactivarse.</strong> No borra datos, servicios ni historial.</p> }
                        <button class="principal" disabled='@(destinoEstado == "Suspendida" && string.IsNullOrWhiteSpace(motivo))' @onclick="ConfirmarEstadoAsync">Confirmar cambio de estado</button>
                        <button class="secundario" @onclick="CancelarEstado">Cancelar</button>
                    </div>
                }
            }
            @if (cuenta.PuedeActivar)
            {
                @if (confirmar)
                {
                    <div class="aviso" role="group" aria-labelledby="confirmar-activacion">
                        <p id="confirmar-activacion">¿Confirmás activar a @cuenta.Nombre @cuenta.Apellido (@cuenta.Email)? Podrá acceder con su rol @cuenta.Rol.</p>
                        <button class="principal" @onclick="ActivarAsync">Confirmar activación</button>
                        <button class="secundario" @onclick="() => confirmar = false">Cancelar</button>
                    </div>
                }
                else { <button class="principal" @onclick="() => confirmar = true">Activar cuenta pendiente</button> }
            }
        }
        <button class="principal" @onclick="RecargarDetalleAsync">Actualizar detalle</button>
        <button class="secundario" @onclick="VolverListadoAsync">Volver al listado</button>
    }
    </fieldset>
</section>

@code {
    [Parameter] public EventCallback Volver { get; set; }
    private PaginaCuentas? listado;
    private CuentaGestion? detalle, cambioRol;
    private string nuevoRol = "", rolListado = "Cliente";
    private int pagina = 1;
    private int? idSeleccionado;
    private string busqueda = "", estado = "", filtroBusqueda = "", filtroEstado = "";
    private string? error, aviso, destinoEstado;
    private string motivo = "";
    private bool ocupada, confirmar, dispuesto;
    private int TotalPaginas => (int)Math.Max(1, ((long)(listado?.Total ?? 0) + 9) / 10);
    private static string EstadoVisible(string valor) => valor == "BajaLogica" ? "Baja lógica" : valor;
    protected override Task OnInitializedAsync() => CargarAsync();
    private async Task EjecutarAsync(Func<Task> accion)
    {
        if (ocupada) return;
        ocupada = true; error = null; confirmar = false;
        try { await accion(); }
        catch (ErrorApi ex) { if (!dispuesto) error = ex.Message; }
        finally { ocupada = false; }
    }
    private async Task LeerListadoAsync()
    {
        listado = null; CancelarRol();
        var resultado = await Sesion.ListarCuentasAsync(pagina, filtroBusqueda, filtroEstado, rolListado);
        // Activar la última cuenta de una página Pendiente puede dejar esa página vacía.
        var ultima = (int)Math.Max(1, ((long)resultado.Total + 9) / 10);
        if (pagina > ultima)
        {
            pagina = ultima;
            resultado = await Sesion.ListarCuentasAsync(pagina, filtroBusqueda, filtroEstado, rolListado);
        }
        if (!dispuesto) listado = resultado;
    }
    private Task FiltrarRolAsync(string rol)
    {
        if (ocupada) return Task.CompletedTask;
        rolListado = rol; pagina = 1; aviso = null;
        return CargarAsync();
    }
    private void PrepararRol(CuentaGestion cuenta, string? rol)
    {
        if (ocupada || rol is not ("Cliente" or "Empleado") || rol == cuenta.Rol) { CancelarRol(); return; }
        cambioRol = cuenta; nuevoRol = rol; aviso = null; error = null;
    }
    private void CancelarRol() { cambioRol = null; nuevoRol = ""; }
    private Task ConfirmarRolAsync() => EjecutarAsync(async () =>
    {
        if (cambioRol is not { } cuenta) return;
        var destino = nuevoRol;
        CancelarRol();
        try
        {
            await Sesion.CambiarRolAsync(cuenta.IdUsuario, cuenta.Rol, destino);
            var guardada = await Sesion.DetalleCuentaAsync(cuenta.IdUsuario);
            if (guardada.Rol != destino)
                throw new ErrorApi(TipoErrorApi.Conflicto, "El rol volvió a cambiar en otra sesión.");
            aviso = $"Rol guardado: {guardada.Rol}. El cambio de rol no activa la cuenta. Consultá la pestaña {guardada.Rol}.";
        }
        catch (ErrorApi ex) when (ex.Tipo == TipoErrorApi.Conflicto)
        { error = ex.Message; aviso = null; }
        await LeerListadoAsync();
    });
    private Task CargarAsync() => EjecutarAsync(LeerListadoAsync);
    private Task BuscarAsync()
    {
        if (ocupada) return Task.CompletedTask;
        filtroBusqueda = busqueda.Trim(); filtroEstado = estado; pagina = 1; aviso = null;
        return CargarAsync();
    }
    private Task PaginarAsync(int cambio)
    {
        if (ocupada) return Task.CompletedTask;
        pagina = Math.Clamp(pagina + cambio, 1, TotalPaginas); aviso = null;
        return CargarAsync();
    }
    private Task AbrirAsync(int id)
    {
        if (ocupada) return Task.CompletedTask;
        idSeleccionado = id; aviso = null; CancelarRol(); CancelarEstado();
        return RecargarDetalleAsync();
    }
    private Task RecargarDetalleAsync() => EjecutarAsync(async () =>
    {
        detalle = null;
        var cuenta = await Sesion.DetalleCuentaAsync(idSeleccionado!.Value);
        if (!dispuesto) detalle = cuenta;
    });
    private Task VolverListadoAsync()
    {
        if (ocupada) return Task.CompletedTask;
        idSeleccionado = null; detalle = null; aviso = null;
        return CargarAsync();
    }
    private void CancelarEstado() { destinoEstado = null; motivo = ""; }
    private void PrepararEstado(string destino) { destinoEstado = destino; motivo = ""; confirmar = false; error = null; aviso = null; }
    private Task ConfirmarEstadoAsync() => EjecutarAsync(async () =>
    {
        if (detalle is not { } c || destinoEstado is null) return;
        aviso = null;
        try
        {
            await Sesion.CambiarEstadoCuentaAsync(c.IdUsuario, c.EstadoCuenta, destinoEstado, destinoEstado == "Suspendida" ? motivo.Trim() : null);
            aviso = "Estado de cuenta guardado correctamente."; CancelarEstado();
        }
        catch (ErrorApi ex) when (ex.Tipo == TipoErrorApi.Conflicto) { error = ex.Message; CancelarEstado(); }
        detalle = await Sesion.DetalleCuentaAsync(c.IdUsuario);
        await LeerListadoAsync();
    });
    private Task ActivarAsync() => EjecutarAsync(async () =>
    {
        if (detalle is not { PuedeActivar: true } cuenta) return;
        // Nunca reintentar automáticamente el POST: ante conflicto se lee el estado actual.
        var conflicto = false;
        try { await Sesion.ActivarCuentaAsync(cuenta.IdUsuario); }
        catch (ErrorApi ex) when (ex.Tipo == TipoErrorApi.Conflicto) { conflicto = true; }
        detalle = null;
        aviso = conflicto ? "La cuenta cambió en otra sesión. Se muestra su estado actual." : "Cuenta activada correctamente.";
        var actual = await Sesion.DetalleCuentaAsync(cuenta.IdUsuario);
        if (!dispuesto) detalle = actual;
        await LeerListadoAsync();
    });
    public void Dispose() { dispuesto = true; listado = null; detalle = null; CancelarRol(); }
}
