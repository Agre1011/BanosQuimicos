@using BanosQuimicos.App.Autenticacion
@inject SesionUsuario Sesion
@implements IDisposable

<section aria-labelledby="titulo-tareas" aria-busy="@cargando">
    <h1 id="titulo-tareas">@(idDetalle is null ? "Tareas asignadas" : "Detalle de tarea")</h1>
    @if (cargando) { <p role="status">Consultando tarea(s)…</p> }
    @if (error is not null) { <p class="aviso error" role="alert">@error</p> <button class="secundario" @onclick="ReintentarAsync">Volver a intentar</button> }
    @if (idDetalle is null)
    {
        @if (tareas is { Count: 0 }) { <p class="aviso" role="status">No tenés tareas asignadas.</p> }
        @if (tareas is not null)
        {
            @foreach (var tarea in tareas)
            {
                <article class="tarjeta tarea-asignada" @key="tarea.IdTarea">
                    <h2>@tarea.Tipo</h2>
                    <p>Tarea @tarea.IdTarea · Servicio @(tarea.IdServicio?.ToString() ?? "sin servicio") · Solicitud @(tarea.IdSolicitud?.ToString() ?? "sin solicitud") · @tarea.Estado</p>
                    <dl class="cuenta-detalle">
                        <dt>Baño</dt><dd>@tarea.CodigoBano</dd>
                        <dt>Dirección</dt><dd>@(tarea.Direccion ?? "Sin dirección registrada")</dd>
                        <dt>Fecha</dt><dd>@Fecha(tarea.FechaProgramada)</dd>
                    </dl>
                    <button class="tareas-empleado" disabled="@cargando" @onclick="() => AbrirAsync(tarea.IdTarea)">Ver detalle →</button>
                </article>
            }
        }
        <button class="salir" disabled="@cargando" @onclick="Volver">Volver</button>
    }
    else
    {
        @if (detalle is { } tarea)
        {
            <article class="tarjeta tarea-asignada">
                <p class="aviso estado-tarea @(tarea.Estado == "Realizada" ? "realizada" : "")">@(tarea.Estado == "Realizada" ? "Realizado" : tarea.Estado)</p>
                <dl class="cuenta-detalle">
                    <dt>Tipo de tarea</dt><dd>@tarea.Tipo</dd>
                    <dt>Tarea</dt><dd>@tarea.IdTarea</dd>
                    <dt>Servicio</dt><dd>@(tarea.IdServicio?.ToString() ?? "Sin servicio asociado")</dd>
                    <dt>Solicitud</dt><dd>@(tarea.IdSolicitud?.ToString() ?? "Retiro administrativo o tarea sin solicitud")</dd>
                    <dt>Cliente</dt><dd>@(tarea.Cliente ?? "Sin servicio asociado")</dd>
                    <dt>Baño</dt><dd>@tarea.CodigoBano</dd>
                    @if (tarea.Tipo == "Traslado")
                    {
                        <dt>Dirección de origen</dt><dd>@(tarea.DireccionOrigen ?? "Sin origen registrado")</dd>
                        <dt>Dirección de destino</dt><dd>@(tarea.DireccionDestino ?? "Sin destino registrado; consultar al administrador")</dd>
                    }
                    else { <dt>Dirección</dt><dd>@(tarea.Direccion ?? "Sin dirección registrada")</dd> }
                    <dt>Fecha</dt><dd>@Fecha(tarea.FechaProgramada)</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(tarea.DescripcionTrabajo)) { <p class="texto-trabajo"><strong>Trabajo indicado:</strong> @tarea.DescripcionTrabajo</p> }
                @if (tarea.Tipo == "Mantenimiento")
                {
                    <p>Condición física actual: @tarea.CondicionBano. Finalizar el mantenimiento no cambia la condición; el administrador debe confirmarla manualmente.</p>
                    <p>Otros mantenimientos bloqueantes pendientes o en curso: @tarea.OtrosMantenimientosBloqueantes.</p>
                    @if (tarea.FechaBajaBano is not null) { <p>Baño dado de baja del inventario.</p> }
                }
                @if (!string.IsNullOrWhiteSpace(tarea.TipoSolicitud)) { <p><strong>Origen:</strong> @tarea.TipoSolicitud</p> }
                @if (!string.IsNullOrWhiteSpace(tarea.DescripcionSolicitud)) { <p class="texto-trabajo"><strong>Descripción de la solicitud:</strong> @tarea.DescripcionSolicitud</p> }
                @if (!string.IsNullOrWhiteSpace(tarea.ObservacionesSolicitud)) { <p class="texto-trabajo"><strong>Observaciones de la solicitud:</strong> @tarea.ObservacionesSolicitud</p> }
                @if (!string.IsNullOrWhiteSpace(tarea.ObservacionesServicio)) { <p class="texto-trabajo"><strong>Observaciones del servicio:</strong> @tarea.ObservacionesServicio</p> }
                @if (!string.IsNullOrWhiteSpace(tarea.ObservacionesEmpleado)) { <p class="texto-trabajo"><strong>Observaciones registradas:</strong> @tarea.ObservacionesEmpleado</p> }
                @if (tarea.PapelHigienicoRepuesto is { } papel) { <p>Papel higiénico repuesto: @(papel ? "Sí" : "No")</p> }
            </article>
            @if (tarea.Tipo == "Retiro")
            {
                <p>Este retiro corresponde al servicio @tarea.IdServicio y a @(tarea.IdSolicitud is int solicitud ? $"la solicitud {solicitud}" : "una operación administrativa sin solicitud").</p>
                @if (tarea.ImpedimentosRetiro is { Count: > 0 } impedimentos)
                {
                    <div class="aviso error" role="alert">
                        <p>Estos trabajos impiden finalizar el retiro:</p>
                        @foreach (var bloqueo in impedimentos) { <p>Tarea @bloqueo.IdTarea · @bloqueo.Tipo · @bloqueo.Estado @(bloqueo.TrabajoRegistrado ? "· trabajo registrado" : "")</p> }
                        <p>Administración debe revisarlos en Baños y Servicios. Los pendientes sin registro que ya no correspondan se cancelan explícitamente; En curso o con trabajo registrado deben completarse.</p>
                    </div>
                }
            }
            else if (tarea.Tipo is "Limpieza semanal" or "Limpieza extra")
            {
                <p>Finalizar esta limpieza no completa un retiro ni da de baja el servicio.</p>
            }
            @if (tarea.FechaTrabajoRegistrado is { } registro)
            {
                <p class="aviso" role="status">Trabajo registrado por @tarea.EmpleadoRegistroTrabajo el @Momento(registro).@(tarea.Estado == "Realizada" ? "" : " El estado todavía no se ha finalizado.")</p>
            }
            @if (tarea.FechaRealizada is { } cierre) { <p role="status">Tarea finalizada el @Momento(cierre).</p> }
            <button class="accion-tarea" disabled="@(cargando || !tarea.PuedeRegistrar)" @onclick="() => GuardarAsync(false)">Registrar Trabajo</button>
            <button class="accion-tarea" disabled="@(cargando || !tarea.PuedeFinalizar)" @onclick="() => GuardarAsync(true)">Actualizar Estado</button>
        }
        <button class="salir" disabled="@cargando" @onclick="CargarAsync">Volver</button>
    }
</section>

@code {
    [Parameter] public EventCallback Volver { get; set; }
    private List<TareaAsignada>? tareas;
    private TareaAsignada? detalle;
    private int? idDetalle;
    private string? error;
    private bool cargando, dispuesto;
    private static string Fecha(DateTimeOffset? fecha) => fecha?.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy") ?? "Sin programar";
    private static string Momento(DateTimeOffset fecha) => fecha.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm:ss") + " (Argentina)";
    protected override Task OnInitializedAsync() => CargarAsync();
    private async Task EjecutarAsync(Func<Task> accion)
    {
        if (cargando) return;
        cargando = true; error = null;
        try { await accion(); }
        catch (ErrorApi ex) { if (!dispuesto) error = ex.Message; }
        finally { cargando = false; }
    }
    private Task CargarAsync() => EjecutarAsync(async () =>
    {
        idDetalle = null; detalle = null; tareas = null;
        var resultado = await Sesion.TareasAsync();
        if (!dispuesto) tareas = resultado;
    });
    private Task AbrirAsync(int id) => EjecutarAsync(async () =>
    {
        idDetalle = id; tareas = null; detalle = null;
        var resultado = await Sesion.DetalleTareaAsync(id);
        if (!dispuesto) detalle = resultado;
    });
    private Task ReintentarAsync() => idDetalle is { } id ? AbrirAsync(id) : CargarAsync();
    private Task GuardarAsync(bool finalizar) => EjecutarAsync(async () =>
    {
        if (idDetalle is not { } id || detalle is null) return;
        // Retirar el detalle anterior evita mostrar una confirmación vieja si el guardado falla.
        detalle = null;
        var resultado = await Sesion.GuardarTrabajoAsync(id, finalizar);
        if (!dispuesto) detalle = resultado;
    });
    public void Dispose() { dispuesto = true; tareas = null; detalle = null; }
}
