<nav aria-label="Páginas del listado">
    <p role="status">@Total resultado(s). Página @Pagina de @Ultima.</p>
    <button class="secundario" disabled="@(Ocupada || Pagina <= 1)" @onclick="() => Cambiar.InvokeAsync(Pagina - 1)">Anterior</button>
    <button class="secundario" disabled="@(Ocupada || Pagina >= Ultima)" @onclick="() => Cambiar.InvokeAsync(Pagina + 1)">Siguiente</button>
</nav>

@code {
    [Parameter] public int Total { get; set; }
    [Parameter] public int Pagina { get; set; } = 1;
    [Parameter] public bool Ocupada { get; set; }
    [Parameter] public EventCallback<int> Cambiar { get; set; }
    private int Ultima => (int)Math.Max(1, ((long)Total + 9) / 10);
}
